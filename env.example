# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/task_underground?sslmode=disable
# Host port for the docker-compose postgres; change it if 5432 is already taken.
POSTGRES_PORT=5432

# Redis. Optional: without it the backend runs single-instance — no WebSocket
# fanout between instances and no rate limiting.
REDIS_URL=redis://localhost:6379

# Server
PORT=8080

# Push notifications. Optional: override only to point at a stub instead of
# the real Expo push service.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Image upload (S3 or any S3-compatible service). Leave AWS_BUCKET_NAME empty
# to disable uploads — /api/v1/upload/presign then answers 503.
AWS_BUCKET_NAME=
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# For MinIO or another S3-compatible endpoint (also switches to path-style URLs):
# AWS_ENDPOINT_URL=http://localhost:9000
# Public read base URL, if it differs from the default bucket URL:
# AWS_PUBLIC_URL=https://cdn.example.com

# Mobile App
EXPO_PUBLIC_API_URL=http://localhost:8080
