{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // node --test runs the .ts sources directly, and Node requires the
    // extension in relative imports.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
